{
  "name": "vite-plugin-typed-sw",
  "version": "1.2.1",
  "description": "A Vite plugin to compile ESM type-safe Service Workers with HMR",
  "keywords": [
    "plugin",
    "service-worker",
    "sw",
    "typed",
    "vite"
  ],
  "license": "MIT",
  "author": "n0tz3r0",
  "files": [
    "dist",
    "client.d.ts",
    "tsconfig.sw.json"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./client": {
      "types": "./client.d.ts"
    },
    "./tsconfig/service-worker": "./tsconfig.sw.json",
    "./sw": "./tsconfig.sw.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "ignore"
    }
  },
  "packageManager": "pnpm@12.4.1"
}
